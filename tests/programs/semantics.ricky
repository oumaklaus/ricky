fn sum6(a, b, c, d, e, f) {
    return a + b + c + d + e + f;
}

fn main() {
    print 2 + 3 * 4;
    print (2 + 3) * 4;
    print 7 / 3;
    print 7 % 3;
    print -7 / 3;
    print -7 % 3;
    print 2 < 3;
    print 2 >= 3;

    let x = 0;
    print 0 && (x = 1);
    print x;
    print 1 || (x = 2);
    print x;

    print sum6(1, 2, 3, 4, 5, 6);
    return 0;
}
